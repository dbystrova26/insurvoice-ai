# InsurVoice AI — Environment Variables
# Copy to .env and fill in. NEVER commit .env.

# Required — reasoning engine (Claude)
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Required — live speech-to-text (Deepgram)
# Free tier: 12,000 min/month. Get key: https://console.deepgram.com
DEEPGRAM_API_KEY=your-deepgram-key-here

# Required — text-to-speech voice reply
# Free tier: 10,000 chars/month. Get key: https://elevenlabs.io/app/developers
ELEVENLABS_API_KEY=your-elevenlabs-key-here

# Optional — Whisper fallback for file uploads (OpenAI)
OPENAI_API_KEY=sk-your-openai-key-here

#Supabase URI   Supabase → Settings → Database 
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.qjowqzqfwrhlzvmxksej.supabase.co:5432/postgres

# Optional — specific ElevenLabs voice (default: Rachel)
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# Auto-generated by Render; set manually for local dev
FLASK_SECRET=change-me-to-a-random-string

# Optional — Simli avatar (real-time lip-synced face)
# Get at: https://simli.com — free tier: 200 min/month
SIMLI_API_KEY=your-simli-key-here
SIMLI_FACE_ID=your-face-id-here
