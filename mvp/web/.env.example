# InsurVoice AI (Web / Flask) — Environment Variables
# Copy to .env and fill in. NEVER commit .env.

# Required — reasoning engine (Claude)
# Get at: https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Required — speech-to-text (Whisper)
# Get at: https://platform.openai.com
OPENAI_API_KEY=sk-your-openai-key-here

# Required — text-to-speech voice
# Get at: https://elevenlabs.io  (free tier: 10,000 chars/month)
ELEVENLABS_API_KEY=your-elevenlabs-key-here

# Optional — specific ElevenLabs voice ID (defaults to "Rachel")
# Find voice IDs at: https://elevenlabs.io/app/voice-library
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# Optional — Flask session secret (Render auto-generates if deployed via render.yaml)
FLASK_SECRET=change-me-to-a-random-string
