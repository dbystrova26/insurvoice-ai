# InsurVoice AI — Environment Variables
# Copy to .env and fill in. NEVER commit .env (it's in .gitignore).

# Required — reasoning engine
# Get at: https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Required for voice INPUT (speech-to-text via Whisper)
# Get at: https://platform.openai.com
OPENAI_API_KEY=sk-your-openai-key-here

# Required for voice OUTPUT (text-to-speech)
# Get at: https://elevenlabs.io  (free tier: 10,000 chars/month)
ELEVENLABS_API_KEY=your-elevenlabs-key-here

# Optional UI customisation
APP_TITLE=InsurVoice AI
